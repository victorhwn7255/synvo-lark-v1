{
  "name": "synvo-lark-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:integration": "node --import tsx --test \"tests/integration/postgres/**/*.test.ts\"",
    "test:integration:workflow-state": "node --import tsx --test tests/integration/postgres/workflow-state.test.ts",
    "test:integration:drive-mutations": "node --import tsx --test tests/integration/postgres/drive-mutations.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate --workspace @synvo/assistant-backend",
    "pin:pilot-identity": "node --env-file=apps/assistant-backend/.env --import tsx apps/assistant-backend/src/verification/pin-pilot-identity.ts",
    "verify:readonly-inventory": "node --env-file=apps/assistant-backend/.env --import tsx apps/assistant-backend/src/verification/verify-readonly-inventory.ts",
    "drive-spike:prepare": "npm run drive-spike:prepare --workspace @synvo/lark-mcp",
    "drive-spike:execute": "npm run drive-spike:execute --workspace @synvo/lark-mcp --",
    "verify:drive-spike": "npm run verify:drive-spike --workspace @synvo/lark-mcp"
  },
  "engines": {
    "node": ">=20.6"
  }
}
