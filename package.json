{
  "name": "@synvo/assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=apps/synvo-assistant/.env --import tsx apps/synvo-assistant/src/index.ts",
    "start": "node --import tsx apps/synvo-assistant/src/index.ts",
    "test": "node --import tsx --test \"apps/synvo-assistant/src/**/*.test.ts\"",
    "test:integration": "node --env-file=apps/synvo-assistant/.env --import tsx --test \"tests/integration/postgres/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file=apps/synvo-assistant/.env --import tsx apps/synvo-assistant/src/db/migrate.ts",
    "doctor": "node --env-file=apps/synvo-assistant/.env --import tsx apps/synvo-assistant/src/doctor.ts"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
