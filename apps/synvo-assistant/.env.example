# If .env already exists, merge missing keys instead of overwriting it.
# Replace every placeholder locally and never paste secrets into chat or commit .env.
LARK_APP_ID=cli_replace_me
LARK_APP_SECRET=replace_me

# Optional Lark image_key for the small animated GIF shown while folder analysis runs.
# Upload apps/synvo-assistant/assets/loading-hourglass.gif as a message image once.
# The card falls back to a text hourglass when this is not configured.
# LARK_LOADING_IMAGE_KEY=img_v3_replace_me

# Local PostgreSQL service for OAuth, workflow state, and durable delivery.
DATABASE_URL=postgresql://synvo_assistant:synvo_assistant_dev@127.0.0.1:5432/synvo_assistant
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# Register this exact loopback URL in Lark Security Settings for the local pilot.
# Complete OAuth from Lark Desktop or a browser on this same computer.
LARK_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/lark/callback
# When the staging host exists, use and register this exact value instead:
# LARK_OAUTH_REDIRECT_URI=https://synvo-assistant-staging.synvo.ai/oauth/lark/callback

# Generate once with: node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("base64url"))'
# Keep the generated value on one line and retain it while encrypted grants exist.
OAUTH_TOKEN_ENCRYPTION_KEY=replace_with_32_random_bytes_base64url

# Required for the Victor-only pilot after the initial OAuth bootstrap.
# OAuth is also bound to the initiating actor and tenant.
# LARK_AUTHORIZED_OPEN_ID=ou_replace_me
# LARK_AUTHORIZED_TENANT_KEY=replace_me
# LARK_AUTHORIZED_FIRST_NAME=Victor

# Optional bearer credential that enables the read-only Synvo MCP endpoint.
# Generate with the same randomBytes command above and send it only to trusted
# MCP clients. The pilot maps every authenticated MCP call to the fixed identity.
# SYNVO_MCP_AUTH_TOKEN=replace_with_32_random_bytes_base64url

# NVIDIA's endpoint and Phase 6 model are fixed in the small provider client.
# Keep the real API key only in .env locally or in production secret management.
LLM_API_KEY=replace_with_nvidia_api_key

# Phase 13 uses Voyage only for fixed voyage-4 document/query embeddings.
# Keep the real key only in .env locally or in hosted secret management.
VOYAGE_API_KEY=replace_with_voyage_api_key

# Exact token after /drive/folder/ in the allowlisted sandbox folder link.
# Keep this value secret and do not place the full folder URL here.
ORGANIZE_FOLDER_ROOT_TOKEN=folder_replace_me

# Master Drive write kill switch.
# Keep this false until a user-facing proposal, explicit approval, verified write,
# and undo loop are ready. Never persist true for read-only work.
ORGANIZE_FOLDER_WRITE_ENABLED=false

# Exact active OAuth profile:
# space:document:retrieve
# space:document:delete
# space:document:move
# space:folder:create
# drive:drive.metadata:readonly
# drive:file:download
# offline_access
# The active workflow must not request upload or broad Drive scopes.
