{
  "name": "@synvo/lark-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./drive": "./src/modules/drive/index.ts"
  },
  "scripts": {
    "dev": "node --env-file=../assistant-backend/.env --import tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
    "drive-spike:prepare": "node --env-file=../assistant-backend/.env --import tsx tools/drive-move-spike/cli.ts prepare",
    "drive-spike:execute": "node --env-file=../assistant-backend/.env --import tsx tools/drive-move-spike/cli.ts execute",
    "verify:drive-spike": "node --env-file=../assistant-backend/.env --import tsx tools/drive-move-spike/live-verifier.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@synvo/contracts": "0.1.0",
    "@synvo/lark-auth": "0.1.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
