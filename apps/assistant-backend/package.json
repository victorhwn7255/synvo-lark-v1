{
  "name": "@synvo/assistant-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
    "migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "pin:pilot-identity": "node --env-file=.env --import tsx src/verification/pin-pilot-identity.ts",
    "verify:readonly-inventory": "node --env-file=.env --import tsx src/verification/verify-readonly-inventory.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@synvo/contracts": "0.1.0",
    "@synvo/lark-auth": "0.1.0",
    "@synvo/lark-mcp": "0.1.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
